# --- Pick your LLM: openai | ollama | fake (offline, for testing) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Free hosted LLaMA via Groq (get a key at console.groq.com)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings: hf (BGE/GTE via sentence-transformers) | fake ---
EMBEDDINGS_PROVIDER=hf
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=thenlper/gte-large

CHROMA_DIR=./data/chroma
TOP_K=5
MAX_REWRITES=2

# --- Public demo safety ---
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=5
AUTO_INGEST_SAMPLES=true
